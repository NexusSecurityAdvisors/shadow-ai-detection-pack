DeviceNetworkEvents
| where (RemoteUrl endswith "api.openai.com" or RemoteUrl endswith "api.anthropic.com" or RemoteUrl endswith "generativelanguage.googleapis.com" or RemoteUrl endswith "api.deepseek.com" or RemoteUrl endswith "api.mistral.ai" or RemoteUrl endswith "api.x.ai" or RemoteUrl endswith "api.groq.com" or RemoteUrl endswith "api.together.xyz" or RemoteUrl endswith "openrouter.ai" or RemoteUrl endswith "api.fireworks.ai" or RemoteUrl endswith "api.cohere.com") and (not((InitiatingProcessFolderPath endswith "\\chrome.exe" or InitiatingProcessFolderPath endswith "\\msedge.exe" or InitiatingProcessFolderPath endswith "\\firefox.exe" or InitiatingProcessFolderPath endswith "\\brave.exe" or InitiatingProcessFolderPath endswith "\\opera.exe")))
